<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>深空器物师 - 文明阵营档案 | 立维宇宙</title>
  
  <link rel="stylesheet" href="../css/base.css">
  <link rel="stylesheet" href="../css/subpage.css">

  <style>
    /* ======================================================= */
    /* 深空器物师专属：沉浸式概念画廊样式 */
    /* ======================================================= */
    .artifact-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
        gap: 30px;
    }
    
    .artifact-card {
        position: relative;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(0, 229, 255, 0.2);
        transition: all 0.4s ease;
        background: #000;
        display: block; /* 保证链接区块完整 */
    }
    
    .artifact-card img {
        width: 100%;
        aspect-ratio: 16 / 9; /* 强制画廊比例为宽屏影视感 */
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s;
        display: block;
    }
    
    /* 悬停时的画廊特效：图片放大微暗，浮出文字 */
    .artifact-card:hover {
        border-color: var(--accent);
        box-shadow: 0 10px 40px rgba(0, 229, 255, 0.3);
    }
    .artifact-card:hover img {
        transform: scale(1.08);
        opacity: 0.5; /* 图片变暗，衬托文字 */
    }
    
    .artifact-info {
        position: absolute;
        bottom: 0; left: 0; width: 100%;
        padding: 30px 20px 20px 20px;
        background: linear-gradient(to top, rgba(2,6,10,0.95) 0%, rgba(2,6,10,0.6) 60%, transparent 100%);
        transform: translateY(20px);
        opacity: 0;
        transition: all 0.4s ease;
        pointer-events: none; /* 让鼠标穿透文字，保持图片交互 */
    }
    .artifact-card:hover .artifact-info {
        transform: translateY(0);
        opacity: 1;
    }
    
    .artifact-meta { font-size: 0.8rem; color: var(--accent); margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px;}
    .artifact-title { font-size: 1.25rem; font-weight: 700; color: #fff; margin-bottom: 5px; }
    .artifact-author { font-size: 0.9rem; color: var(--accent-gold); }

    /* 手机端适配：默认显示文字，不依赖悬停 */
    @media (max-width: 768px) {
        .artifact-info { transform: translateY(0); opacity: 1; padding: 40px 15px 15px 15px; }
        .artifact-card img { opacity: 0.8; }
    }
  </style>
</head>
