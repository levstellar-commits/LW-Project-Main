  <style>
    /* ======================================================= */
    /* 初元先知会专属：黑金殿堂与黑曜石碑样式 */
    /* ======================================================= */
    .pantheon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 40px;
    }
    
    .prophet-card {
        background: linear-gradient(145deg, #161616, #0a0a0a);
        border: 1px solid rgba(212, 175, 55, 0.3); /* 典雅的暗金色 */
        border-radius: 2px; /* 故意使用极小圆角，显得像石碑般庄重 */
        padding: 40px 30px;
        position: relative;
        transition: all 0.5s ease;
        box-shadow: 0 20px 40px rgba(0,0,0,0.8), inset 0 0 0 1px rgba(255,255,255,0.05);
        display: flex;
        flex-direction: column;
    }

    /* 烫金边角装饰 */
    .prophet-card::before, .prophet-card::after {
        content: '';
        position: absolute;
        width: 15px; height: 15px;
        border: 1px solid #d4af37;
        transition: all 0.3s ease;
    }
    .prophet-card::before { top: -1px; left: -1px; border-right: none; border-bottom: none; }
    .prophet-card::after { bottom: -1px; right: -1px; border-left: none; border-top: none; }

    .prophet-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(212, 175, 55, 0.15), inset 0 0 0 1px rgba(212, 175, 55, 0.2);
    }

    .prophet-card:hover::before, .prophet-card:hover::after {
        width: 100%; height: 100%;
        opacity: 0.1;
    }

    /* 巨大的背景引号水印 */
    .quote-mark {
        position: absolute;
        top: 20px;
        left: 20px;
        font-family: Georgia, serif;
        font-size: 6rem;
        color: rgba(212, 175, 55, 0.08);
        line-height: 1;
        pointer-events: none;
    }

    .prophet-quote {
        font-size: 1.05rem;
        color: #e5e7eb;
        line-height: 1.8;
        font-weight: 300;
        margin-bottom: 30px;
        position: relative;
        z-index: 2;
        letter-spacing: 0.5px;
    }

    .prophet-profile {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-top: auto;
        padding-top: 20px;
        border-top: 1px solid rgba(212, 175, 55, 0.2);
        z-index: 2;
    }

    .prophet-avatar {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        border: 2px solid #d4af37;
        background: #222;
        box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
    }

    .prophet-info {
        display: flex;
        flex-direction: column;
    }

    .prophet-name {
        font-size: 1.1rem;
        font-weight: 700;
        color: #d4af37; /* 鎏金色 */
        letter-spacing: 1px;
    }

    .prophet-title {
        font-size: 0.8rem;
        color: #9ca3af;
        margin-top: 3px;
    }

    /* 专属金印徽章 */
    .prophet-seal {
        position: absolute;
        bottom: 30px;
        right: 30px;
        width: 40px;
        height: 40px;
        opacity: 0.8;
        background-image: radial-gradient(circle, rgba(212, 175, 55, 0.2) 20%, transparent 60%);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 1.5rem;
        color: rgba(212, 175, 55, 0.5);
    }

  </style>
