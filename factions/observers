  <style>
    /* ======================================================= */
    /* 时空观测员专属：玻璃拟态与梦境记忆标本样式 */
    /* ======================================================= */
    .memory-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 35px;
    }
    
    .memory-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(12px); /* 玻璃模糊效果 */
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(192, 132, 252, 0.2);
        border-radius: 16px;
        padding: 30px;
        text-decoration: none;
        display: flex;
        flex-direction: column;
        transition: all 0.5s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    
    /* 卡片内部的霓虹光晕 */
    .memory-card::before {
        content: '';
        position: absolute;
        top: -50px; left: -50px;
        width: 100px; height: 100px;
        background: radial-gradient(circle, rgba(192, 132, 252, 0.4) 0%, transparent 70%);
        border-radius: 50%;
        opacity: 0.5;
        transition: all 0.5s ease;
    }
    
    .memory-card:hover {
        transform: translateY(-8px) scale(1.02);
        border-color: rgba(192, 132, 252, 0.6);
        box-shadow: 0 15px 40px rgba(192, 132, 252, 0.2);
        background: rgba(255, 255, 255, 0.05);
    }
    
    .memory-card:hover::before {
        transform: scale(2);
        opacity: 0.8;
    }
    
    .obs-meta { 
        font-size: 0.8rem; 
        color: #c084fc; 
        margin-bottom: 20px; 
        display: flex; 
        justify-content: space-between; 
        align-items: center;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .obs-badge {
        background: rgba(192, 132, 252, 0.15);
        padding: 4px 10px;
        border-radius: 20px;
        border: 1px solid rgba(192, 132, 252, 0.3);
    }
    
    .obs-title { 
        font-size: 1.3rem; 
        font-weight: 700; 
        color: #fff; 
        margin-bottom: 15px; 
        line-height: 1.4; 
        z-index: 1; /* 确保文字在光晕之上 */
    }
    
    .obs-excerpt { 
        font-size: 0.95rem; 
        color: #d1d5db; 
        line-height: 1.8; 
        flex-grow: 1; 
        margin-bottom: 25px; 
        font-style: italic;
        z-index: 1;
    }
    
    .obs-author { 
        font-size: 0.9rem; 
        color: #9ca3af; 
        display: flex; 
        align-items: center; 
        justify-content: space-between;
        border-top: 1px solid rgba(255,255,255,0.08);
        padding-top: 15px;
        z-index: 1;
    }
    
    .obs-author .resonance { 
        color: #e879f9; 
        font-weight: bold; 
        display: flex;
        align-items: center;
        gap: 5px;
    }
  </style>
